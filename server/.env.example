# Banco próprio: copie para .env. Demonstração nativa usa .env.development.local.
# Nunca publique senhas ou chaves.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://fitflow:SENHA_CODIFICADA_NA_URL@127.0.0.1:3306/fitflow
# Para Neon: DATABASE_PROVIDER=postgresql, DATABASE_URL com pool e DIRECT_URL sem pool.
# DIRECT_URL pode vir de DATABASE_URL_UNPOOLED fornecida pela integração Vercel.
# Credenciais permanecem exclusivamente no servidor.
DATABASE_PROVIDER=mysql
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Origens exatas separadas por vírgula, sem caminho nem barra final.
CORS_ORIGIN=http://localhost:3000
DEBUG_SQL=false

# IA educativa opcional. Chave apenas no backend.
IA_PROVIDER=groq
# Confirmar o plano Free no console antes de trocar para true.
# Esta configuração não altera o plano nem garante a quota da conta.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_TIER_CONFIRMED=false
# Alternativa existente: IA_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sandbox desativado até configurar TODOS os campos.
MP_SANDBOX_ENABLED=false
MP_SANDBOX_ACCESS_TOKEN=
MP_SANDBOX_WEBHOOK_SECRET=
MP_SANDBOX_SELLER_ID=
MP_SANDBOX_BUYER_EMAIL=
MP_SANDBOX_PUBLIC_URL=
